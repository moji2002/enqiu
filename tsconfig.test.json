{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "bench/**/*.ts",
    "examples/scenarios/**/*.ts"
  ]
}
