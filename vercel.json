{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile && npm --prefix site ci",
  "buildCommand": "npm --prefix site run build:landing",
  "outputDirectory": "site/public",
  "routes": [
    {
      "src": "^/fonts/(.*)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/llms\\.txt$",
      "headers": { "Content-Type": "text/plain; charset=utf-8" },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/llm\\.txt$",
      "dest": "/llms.txt"
    },
    {
      "src": "^/.*$",
      "status": 404
    }
  ]
}
